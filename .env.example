# ==================================================
# JOB SEARCH CONFIGURATION
# ==================================================

# Job sources supported by the configured job collection integration.
# Separate multiple sources with commas.
# Example: indeed
JOB_SOURCES=indeed

# Job titles / keywords to search for.
# Separate multiple search terms with commas.
SEARCH_TERMS=data analyst,business analyst,data engineer

# Search location
LOCATION=Belgium

# Only collect jobs posted within the last X hours
HOURS_OLD=72

# Maximum number of results requested per search term and source
RESULTS_EACH=20


# ==================================================
# AI FILTERING
# ==================================================

# Anthropic API key used for LLM-based job evaluation
CLAUDE_API_KEY=your_claude_api_key

# Optional: Claude model
# Leave empty to use the default model configured in Python
CLAUDE_MODEL=


# ==================================================
# GITHUB GIST
# ==================================================

# GitHub token used to read/write the Gist
GIST_TOKEN=your_github_token

# ID of the Gist used to persist processed job data
GIST_ID=your_gist_id


# ==================================================
# OPTIONAL ADZUNA INTEGRATION
# ==================================================

# Leave these empty if Adzuna is not being used
ADZUNA_APP_ID=
ADZUNA_API_KEY=


# ==================================================
# OPTIONAL EMAIL DELIVERY
# ==================================================

# Gmail account used to send the results
GMAIL_FROM=

# Gmail App Password
# Do NOT use your normal Gmail password
GMAIL_APP_PASSWORD=

# Destination email address
# Leave empty if the application should send to GMAIL_FROM
GMAIL_TO=
